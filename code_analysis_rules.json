{
  "log_level": "all",
  "max_lines_per_file": {
    "enabled": true,
    "warning": 300,
    "error": 500,
    "exclude_patterns": [
      "node_modules/**",
      "dist/**",
      "build/**",
      "coverage/**",
      ".git/**",
      "code_analysis_results/**",
      "venv/**",
      ".venv/**",
      "__pycache__/**",
      "*.pyc"
    ]
  },
  "pmd_duplicates": {
    "enabled": true,
    "minimum_tokens": 100,
    "exclude_patterns": {
      "python": [
        "node_modules/**",
        "dist/**",
        "build/**",
        "coverage/**",
        ".git/**",
        "code_analysis_results/**",
        "venv/**",
        ".venv/**",
        "__pycache__/**",
        "*.pyc"
      ]
    }
  },
  "pmd_similar_code": {
    "enabled": false,
    "minimum_tokens": 100,
    "ignore_identifiers": true,
    "ignore_literals": true,
    "ignore_annotations": false
  },
  "ruff_analyze": {
    "enabled": true,
    "select": ["E", "F", "W", "I", "UP", "B", "SIM"],
    "ignore": [],
    "exclude_patterns": [
      "node_modules",
      "dist",
      "build",
      "coverage",
      ".git",
      "code_analysis_results",
      "venv",
      ".venv",
      "__pycache__"
    ]
  }
}
